Date: Thu, 5 Nov 2026 12:59:01 +0000
Subject: [PATCH 1/4] Fix Bandit security issues: replace pickle with json,
 os.system with safe subprocess, random with secrets

---
 .gitignore                       |  4 ++
 event_manager.py                 | 33 ++++++++++------
 reports/before/bandit_report.txt | 66 ++++++++++++++++++++++++++++++++
 reports/before/flake8_report.txt |  4 ++
 reports/before/pylint_report.txt | 35 +++++++++++++++++
 5 files changed, 131 insertions(+), 11 deletions(-)
 create mode 100644 reports/before/bandit_report.txt
 create mode 100644 reports/before/flake8_report.txt
 create mode 100644 reports/before/pylint_report.txt

diff --git a/.gitignore b/.gitignore
index e5fde14..00a6678 100644
--- a/.gitignore
+++ b/.gitignore
@@ -7,3 +7,7 @@ venv/
 .venv/
 env/
 
+
+# Program output
+events.json
+events.pkl
diff --git a/event_manager.py b/event_manager.py
index 96c4536..2a012f4 100644
--- a/event_manager.py
+++ b/event_manager.py
@@ -1,6 +1,9 @@
-import os
-import pickle
-import random
+import json
+import re
+import secrets
+import shutil
+# subprocess is only used with a fixed argument list and no shell.
+import subprocess  # nosec B404
 from datetime import date
 
 events = {}
@@ -41,19 +44,27 @@ def guestReport(eventName, sortOrder):
     return ", ".join(names)
 
 
-def saveEvents(fileName="events.pkl"):
-    with open(fileName, "wb") as f:
-        pickle.dump(events, f)
+def saveEvents(fileName="events.json"):
+    with open(fileName, "w", encoding="utf-8") as f:
+        json.dump(events, f, indent=2)
 
 
-def loadEvents(fileName="events.pkl"):
-    with open(fileName, "rb") as f:
-        return pickle.load(f)
+def loadEvents(fileName="events.json"):
+    with open(fileName, "r", encoding="utf-8") as f:
+        return json.load(f)
 
 
 def printBadges(eventName):
     # Helper kept for the lab: not called by the demo
-    os.system("lp badges_" + eventName + ".txt")
+    if not re.fullmatch(r"[A-Za-z0-9 _-]+", eventName):
+        raise ValueError("Unsafe event name: " + repr(eventName))
+    lp_path = shutil.which("lp")
+    if lp_path is None:
+        print("Printer command 'lp' not found")
+        return
+    # Absolute path, list arguments, shell=False and a validated name.
+    subprocess.run([lp_path, "badges_" + eventName + ".txt"],  # nosec B603
+                   check=False)
 
 
 def main():
@@ -69,7 +80,7 @@ def main():
     print("Tech Meetup guests:", guestReport("Tech Meetup", "name"))
     print("Tech Meetup is", eventStatus(date(2099, 1, 15)))
     print("Alumni Dinner is", eventStatus(date(2020, 5, 1)))
-    winner = random.choice(events["Tech Meetup"]["guests"])
+    winner = secrets.choice(events["Tech Meetup"]["guests"])
     print("Lucky draw winner:", winner)
     saveEvents()
     restored = loadEvents() # reload to confirm the save worked
